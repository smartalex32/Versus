+static Bool
+hostx_init_wm_delete_atoms(void)
+{
+    xcb_intern_atom_cookie_t protocols_cookie;
+    xcb_intern_atom_cookie_t delete_cookie;
+    xcb_intern_atom_reply_t *protocols_reply;
+    xcb_intern_atom_reply_t *delete_reply;
+
+    protocols_cookie = xcb_intern_atom(HostX.conn, FALSE,
+                                       strlen("WM_PROTOCOLS"), "WM_PROTOCOLS");
+    delete_cookie = xcb_intern_atom(HostX.conn, FALSE,
+                                    strlen("WM_DELETE_WINDOW"),
+                                    "WM_DELETE_WINDOW");
+    protocols_reply = xcb_intern_atom_reply(HostX.conn, protocols_cookie, NULL);
+    delete_reply = xcb_intern_atom_reply(HostX.conn, delete_cookie, NULL);
+    if (!protocols_reply || !delete_reply) {
+        free(protocols_reply);
+        free(delete_reply);
+        return FALSE;
+    }
+
+    HostX.wm_protocols = protocols_reply->atom;
+    HostX.wm_delete_window = delete_reply->atom;
+    free(protocols_reply);
+    free(delete_reply);
+    return TRUE;
+}
