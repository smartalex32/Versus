+Bool
+hostx_is_wm_delete_event(const xcb_client_message_event_t *event)
+{
+    int index;
+
+    if (!event || event->format != 32 ||
+        event->type != HostX.wm_protocols ||
+        event->data.data32[0] != HostX.wm_delete_window)
+        return FALSE;
+
+    for (index = 0; index < HostX.n_screens; index++) {
+        EphyrScrPriv *scrpriv = HostX.screens[index]->driver;
+
+        if (scrpriv && scrpriv->win_pre_existing == XCB_WINDOW_NONE &&
+            event->window == scrpriv->win)
+            return TRUE;
     }
+
+    return FALSE;
 }
 
+Bool
+hostx_write_close_marker(void)
+{
+    const char *path = getenv("VERSUS_X11_CLOSE_MARKER");
+    int fd;
+
+    if (!path || !*path)
+        return TRUE;
+
+    fd = open(path, O_CREAT | O_EXCL | O_WRONLY | O_CLOEXEC | O_NOFOLLOW,
+              S_IRUSR | S_IWUSR);
+    if (fd < 0)
+        return FALSE;
+
+    return close(fd) == 0;
+}
